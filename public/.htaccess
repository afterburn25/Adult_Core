# Apache/cPanel routing. Only this public/ directory may be exposed by the host.
Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^index\.php$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>
<FilesMatch "^(?:\.ht|.*\.(?:env|ini|log|sql|bak|dist))$">
    Require all denied
</FilesMatch>
